{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joma",
  "compatibility_date": "2026-08-27",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kuncepto-contact",
      "database_id": "c46947ad-4d14-4716-8ed9-c84e2d893e46",
      "migrations_dir": "migrations"
    }
  ]
}
